# --- Modes (defaults run fully offline) ---
PAYPAL_MODE=mock            # mock | sandbox
AI_MODE=fixture             # fixture | live
PAYOUT_MODE=real            # real | simulated (fallback only; UI labels it)
JUDGE_MODE=true

# --- PayPal sandbox (platform REST app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ACCESS_TOKEN=        # only for the local PayPal MCP server (.mcp.json)
SCHOOL_PAYPAL_EMAIL=sb-lakeview@business.example.com
LOOKALIKE_PAYPAL_EMAIL=sb-lookalike@personal.example.com

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # current Claude model id with vision support
AI_RECORD=0
LIVE_AI_DAILY_BUDGET=200

# --- Security ---
TICKET_SECRET=change-me-32-bytes-hex
DEMO_RESET_TOKEN=change-me
SCHOOL_PRIVATE_KEY=         # base64 PEM, generate with: pnpm keys
SCHOOL_PUBLIC_KEY=

# --- App ---
DATABASE_PATH=.data/earmark.db
APP_URL=http://localhost:3000
KES_DISPLAY_RATE=129        # display-only estimate
