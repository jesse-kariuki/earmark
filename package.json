  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "4.0.105",
    "@base-ui/react": "^1.9.0",
    "@paypal/agent-toolkit": "1.11.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "ag-grid-community": "33.3.2",
    "ag-grid-react": "33.3.2",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "nanoid": "^6.0.2",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
